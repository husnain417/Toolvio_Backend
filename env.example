# Database Configuration
MONGODB_URI=mongodb://localhost:27017/toolivo
MONGODB_URI_TEST=mongodb://localhost:27017/toolivo_test

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# System Bootstrap Configuration
SYSTEM_BOOTSTRAP_KEY=SYSTEM_BOOTSTRAP_KEY_2025
SYSTEM_ADMIN_EMAIL=admin@craftsman-platform.com
SYSTEM_ADMIN_PASSWORD=SystemAdmin123!
SYSTEM_ADMIN_FIRST_NAME=System
SYSTEM_ADMIN_LAST_NAME=Administrator

# Production Super Admin Configuration
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=admin@craftsman-platform.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Administrator

# Redis Configuration for BullMQ Background Processing
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue Configuration
QUEUE_CONCURRENCY=5
AUDIT_JOB_ATTEMPTS=3
AUDIT_JOB_BACKOFF=exponential

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Audit Configuration
AUDIT_RETENTION_DAYS=365
AUDIT_MAX_VERSIONS=1000

# Schema Configuration
SCHEMA_VALIDATION_STRICT=true
SCHEMA_CACHE_TTL=3600000
